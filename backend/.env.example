# Web server
PORT=3000
HOST=127.0.0.1        # use 0.0.0.0 to expose on your LAN (there is no login!)

# PostgreSQL – either a single URL...
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/rtsp_viewer
# ...or the individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=stream_test

# Optional: full path to ffmpeg if it is not on your PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Allowed frontend origin(s), comma separated (* = any)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
